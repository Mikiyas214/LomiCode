# Copy this file to .env and fill in your own Supabase project values.
# Never commit your real .env file — it's already listed in .gitignore.
#
# Find these in your Supabase project: Project Settings → API
#   - VITE_SUPABASE_URL      -> "Project URL"
#   - VITE_SUPABASE_ANON_KEY -> "anon" / "public" key (NOT the service_role key)
#
# Do not put the service_role key, a database password, or any other
# secret in this file — it is only ever safe to use the anon key in the
# frontend, because Row Level Security (see supabase-schema.sql) restricts
# what that key is allowed to do.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
